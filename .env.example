# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (https://resend.com) — transactional email
RESEND_API_KEY=""
# Sender on a domain VERIFIED in Resend, e.g. "VocabVault <hello@mail.yourdomain.com>".
# If unset, Resend's sandbox sender is used, which only delivers to the Resend account owner.
RESEND_FROM=""

# Shared secret for the streak-reminder cron: GET/POST /api/cron/streak-risk
# with header "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -base64 32
CRON_SECRET=""

# Optional: enables AI word selection + context-aware meanings in the paragraph analyzer.
# Without it, the built-in dictionary engine is used.
ANTHROPIC_API_KEY=""
