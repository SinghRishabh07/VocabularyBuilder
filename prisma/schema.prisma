generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PartOfSpeech {
  noun
  verb
  adjective
  adverb
}

model User {
  id        String    @id @default(uuid())
  googleId  String    @unique
  email     String    @unique
  name      String?
  image     String?
  /// Target words to add per day (progress daily goal)
  dailyWordGoal Int     @default(5)
  /// YYYY-MM-DD (UTC) when we last sent a “streak at risk” email (prevents duplicate sends)
  streakRemindYmd String?
  /// In-app: level up pending until user sees dismiss (null = no pending)
  levelUpFrom  Int?
  levelUpTo    Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions       Session[]
  words          Word[]
  reviewSessions ReviewSession[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Word {
  id         String   @id @default(uuid())
  word       String
  createdAt  DateTime @default(now())
  isFavorite Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  meanings Meaning[]

  // ── Revision / spaced repetition (simplified SM-2) ──
  /// Ease multiplier applied to the interval after a successful recall (min 1.3)
  reviewEase     Float     @default(2.5)
  /// Current interval in days between reviews
  reviewInterval Int       @default(0)
  /// When the word is next due for revision (new words are due immediately)
  reviewDueAt    DateTime  @default(now())
  lastReviewedAt DateTime?
  /// Total graded answers / correct answers / times forgotten
  reviewCount    Int       @default(0)
  correctCount   Int       @default(0)
  lapseCount     Int       @default(0)

  @@unique([userId, word])
  @@index([userId, reviewDueAt])
}

/// One revision session. Answers are recorded as they happen, so progress
/// survives the user leaving mid-session.
model ReviewSession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            String    @default("smart")
  plannedCount    Int
  answeredCount   Int       @default(0)
  correctCount    Int       @default(0)
  /// Word ids already graded in this session (makes answer submission idempotent)
  answeredWordIds String[]  @default([])
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([userId, startedAt])
}

model Meaning {
  id                String       @id @default(uuid())
  type              PartOfSpeech // 2. Applied the enum here
  dictionaryMeaning String?
  personalMeaning   String?

  wordId            String
  word              Word         @relation(fields: [wordId], references: [id], onDelete: Cascade)

  examples          Example[]
}

model Example {
  id                String  @id @default(uuid())
  dictionaryExample String?
  personalExample   String?

  meaningId         String
  meaning           Meaning @relation(fields: [meaningId], references: [id], onDelete: Cascade)
}